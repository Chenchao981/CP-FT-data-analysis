# API users see only code/name and relative paths; real roots and ACLs remain under administrator control.
# QUICK_ANALYSIS reads near-data inputs without Canonical ingestion. Every QUICK_ANALYSIS root must bind one iam.data_domain by data_domain_code; the API lists, browses, previews and runs it only for an active, unexpired user grant. FORMAL_IMPORT takes an immutable snapshot under TMS_UPLOAD_ROOT before queueing.
TMS_SOURCE_ROOTS_JSON=[{"code":"JIEQUN_FT_SHARED","name":"杰群 FT 共享数据","path":"F:\\shared\\ft\\jiequn","purpose":"QUICK_ANALYSIS","data_domain_code":"JIEQUN_FT","test_stage":"FT","factory_code":"JIEQUN","allowed_suffixes":[".csv"]},{"code":"RIYUEXIN_PRODUCTION","name":"日月新量产 FT","path":"F:\\shared\\formal\\ft\\riyuexin","purpose":"FORMAL_IMPORT","data_domain_code":"RIYUEXIN_FT","business_domains":["PRODUCTION"],"test_stage":"FT","factory_code":"RIYUEXIN","allowed_suffixes":[".xlsx"]}]
