# SQLAlchemy URL; keep the real password outside Git.
TMS_DATABASE_URL=mssql+pyodbc://user:password@server:1433/TMS_G0_DEV?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no&TrustServerCertificate=yes
TMS_JOB_REPOSITORY=memory
TMS_ENV=development
TMS_LOG_LEVEL=INFO
TMS_LOG_DIR=F:\CP-FT数据分析\data\logs
TMS_LOG_MAX_BYTES=10485760
TMS_LOG_BACKUP_COUNT=10
TMS_PROCESS_NAME=tms
TMS_API_HOST=127.0.0.1
TMS_API_PORT=8000
# Keep true outside explicit local development/test acceptance runs.
TMS_AUTH_REQUIRED=true
# Optional active iam.app_user id for development/test only when authentication is disabled.
# Prefer a dedicated non-personal account; if blank, the first active SYSTEM_ADMIN is used.
TMS_DEVELOPMENT_USER_ID=
TMS_JWT_SECRET=replace-with-an-environment-specific-secret
TMS_ACCESS_TOKEN_MINUTES=480
TMS_CLEANER_PYTHON=D:\ProgramData\anaconda3\python.exe
TMS_CP_CLEANER_RELEASE=F:\cp_data_ansys\packaging\release
TMS_FT_CLEANER_RELEASE=F:\data_IGBT_multiple\packaging\release
TMS_UPLOAD_ROOT=F:\CP-FT数据分析\data\raw
TMS_PROCESSED_ROOT=F:\CP-FT数据分析\data\processed
TMS_QUICK_WORK_ROOT=F:\CP-FT数据分析\data\workspace
TMS_QUICK_RESULT_TTL_HOURS=168
TMS_QUICK_MAX_SOURCE_FILES=100000
TMS_QUICK_GLOBAL_CAPACITY_BYTES=107374182400
TMS_QUICK_USER_CAPACITY_BYTES=21474836480
TMS_QUICK_MIN_FREE_BYTES=10737418240
TMS_QUICK_RESERVE_RATIO=0.5
TMS_QUICK_RESERVE_OVERHEAD_BYTES=67108864
